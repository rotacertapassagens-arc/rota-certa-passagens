/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; frame-src https://www.google.com; connect-src 'self'; upgrade-insecure-requests

/admin*
  X-Robots-Tag: noindex, nofollow

/financeiro*
  X-Robots-Tag: noindex, nofollow

/recibo*
  X-Robots-Tag: noindex, nofollow

/painel-parceiro*
  X-Robots-Tag: noindex, nofollow

/master-invite*
  X-Robots-Tag: noindex, nofollow

/parceiro-convite*
  X-Robots-Tag: noindex, nofollow

/reset-password*
  X-Robots-Tag: noindex, nofollow

# Fontes: o nome do arquivo muda se a fonte mudar, então podem ficar em cache por 1 ano.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Guias em PDF (lead magnet do Instagram): endereço fixo, então cache curto para
# uma versão nova chegar logo; noindex para o Google indexar o post do blog, não o PDF.
/guias/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Fotos do blog (/assets/blog/*): o nome do arquivo identifica a foto, então cache de 30 dias.
# Para trocar uma foto no ar, suba com outro nome.
/assets/blog/*
  Cache-Control: public, max-age=2592000
