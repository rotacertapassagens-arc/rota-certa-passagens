NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://rota_certa:local-only-change-me@localhost:5432/rota_certa
TOKEN_PEPPER=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-another-32-random-characters
SESSION_TTL_HOURS=720
COOKIE_SECURE=false

# Keep capture mode locally. Set resend only during an approved deployment.
EMAIL_MODE=capture
RESEND_API_KEY=
EMAIL_FROM=Rota Certa Passagens <no-reply@example.invalid>

# Stripe sandbox only. Production keys are rejected by the application.
PAYMENTS_MODE=stripe_sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One-time bootstrap authorization used only to create the first master invite.
MASTER_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
